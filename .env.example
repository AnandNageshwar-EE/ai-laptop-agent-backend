# Copy to .env and fill in. Never commit .env.
# Every value below is read from the environment; nothing is hard-coded.

# ----- application identity (appears in trace metadata) -----
APPLICATION=ai-laptop-agent
ENVIRONMENT=local
GRAPH_VERSION=v1

# ----- HTTP API -----
API_HOST=0.0.0.0
API_PORT=8000
# Explicit allowlist. Never "*".
CORS_ALLOW_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# ----- LLM -----
# offline = deterministic rule-based reasoning, no API key needed (default).
# live    = calls the model. Requires ANTHROPIC_API_KEY.
LLM_MODE=offline
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
# Structured-output retries: retry once, then fail gracefully.
LLM_STRUCTURED_RETRIES=1

ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=bedrock (requires the langchain-aws package).
AWS_REGION=us-east-1

# ----- prompt caching -----
PROMPT_CACHING_ENABLED=true
# "5m" (default) or "1h". 1h doubles the write cost, so it needs more reads to pay off.
PROMPT_CACHE_TTL=5m

# ----- product/offer caching (volatile: max 300s, enforced by validation) -----
PRODUCT_CACHE_TTL_SECONDS=300
OFFER_CACHE_TTL_SECONDS=120

# ----- guardrails -----
MAX_INPUT_CHARS=2000
MAX_SEARCH_RESULTS=20
RECOMMENDATION_MAX_REPAIR_ATTEMPTS=2

# ----- session state (in-memory) -----
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=1000

# ----- LangSmith -----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-laptop-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ----- logging -----
LOG_LEVEL=INFO
LOG_JSON=true
